rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRegisteredAccount() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function uid() {
      return request.auth.uid;
    }

    // Own profile always readable. Peers: registered callers (or a consented child reading
    // their own family — FR-85), and target must not be anonymous.
    //
    // FR-12 (COPPA F-5b): a peer may not read a child's user doc unless they are in the
    // child's active family. Clause order is load-bearing:
    //   1. the child check comes FIRST, so an adult target (the overwhelming majority)
    //      short-circuits and pays no extra document access at all;
    //   2. the `'activeFamilyId' in resource.data` key-presence guard comes BEFORE the path
    //      is constructed, so an orphaned child — flag sticky, family cleared on exit —
    //      denies cleanly instead of erroring on a malformed path. An ex-family member is
    //      therefore denied along with every other stranger.
    // The carve-out exists because family screens hydrate rosters by reading each member's
    // user doc directly (`UserProfileListenCoordinator` / `UserRepository.getUser`);
    // without it, flagging a child would silently break their own family's roster.
    //
    // FR-85 (F-42) widens the CALLER side to a consented child reading their own family,
    // and corrects the TARGET side for the same reason. FR-48's anonymous-target exclusion
    // (`isRegistered != false`) is the adult discoverability control; a consented child is
    // now an ANONYMOUS account (FR-60), so their own user doc carries `isRegistered: false`
    // (written by `FirebaseAuthService.saveUserDataToFirestore`) and that clause was hiding
    // consented children from their OWN family — the FR-12 degradation this carve-out exists
    // to prevent. For a child target the FR-12 family carve-out IS the discoverability
    // control and is strictly stronger, so the two controls are now branches of one test
    // rather than a conjunction. Adult targets are byte-for-byte unchanged; a plain
    // anonymous NON-child target is still excluded.
    function isDiscoverableUserProfile(userId) {
      return uid() == userId
        || ((isRegisteredAccount() || callerIsConsentedChildFamilyPeerOf(userId))
            && ( resource.data.get('isChildAccount', false) != true
                 ? resource.data.get('isRegistered', true) != false
                 : ( 'activeFamilyId' in resource.data
                     && exists(/databases/$(database)/documents/families/$(resource.data.activeFamilyId)/members/$(request.auth.uid)) ) ));
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isRetiredGeneral(userId) {
      return userDoc(userId).data.isRetiredGeneral == true;
    }

    // Rules cannot iterate lists, so bound the array and check every index explicitly.
    // `platform` is a 7-case enum and the client dedupes by platform, so 7 is the true cap.
    function linkedPlatformEntryIsPublicSafe(entries, i) {
      return entries.size() <= i
        || entries[i].keys().hasOnly(["platform", "platformUserId", "linkedAt"]);
    }

    // FR-43: peer-readable linkedPlatforms carry identity only. Provider email / phoneNumber /
    // displayName belong to users/{uid}/private/contact.
    function userDocLinkedPlatformsAreSanitized() {
      return !request.resource.data.keys().hasAny(["linkedPlatforms"])
        || (request.resource.data.linkedPlatforms is list
            && request.resource.data.linkedPlatforms.size() <= 7
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 0)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 1)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 2)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 3)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 4)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 5)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 6));
    }

    // Reads are document-level, so anything a peer must not see cannot live on users/{uid}:
    // contact goes to private/contact, the push token to private/fcm (FR-43 / audit E1).
    // firstName/lastName: real names are never collected (owner decision, F-6 rework).
    // Deleting a field with FieldValue.delete() keeps it out of request.resource.data, so
    // migration writes that strip these keys still pass.
    // entitlementTags may remain on merge results; clients must not *change* them
    // (see userDocPreservesEntitlementTags). Do not list them here or updates fail for tagged users.
    function userDocHasNoPrivateFields() {
      return !request.resource.data.keys().hasAny([
        "deviceIdentifier",
        "lastLoginLocationData",
        "lastLoginLocations",
        "lastLoginLocation",
        "email",
        "phoneNumber",
        "firstName",
        "lastName",
        "fcmToken",
        "fcmTokenUpdatedAt"
      ]) && userDocLinkedPlatformsAreSanitized();
    }

    // FR-7 (COPPA F-5a): server-controlled user-doc fields. `entitlementTags` are granted
    // by entitlement functions; `isChildAccount` is the authoritative child flag written
    // only by declareChildRegistration / setFamilyMemberChildStatus /
    // approveFamilyJoinRequest_CaptainStep. A client write may carry them through
    // unchanged (merge results) but may never change, add, or remove them.
    // FR-60(c) adds `childDeclaredAt`: the server timestamp that opens a declared child's
    // redemption window and, once deleted at family admission, closes it. It drives the
    // transient-account sweep, so a client that could write or clear it could either delete
    // its own pre-consent footprint on demand or keep an unconsented account alive forever.
    // FR-88 adds `pendingFamilyRequest`: written when a join request is minted and retired on
    // every resolution — deleted, or (on a decline) re-pointed at a request still live in
    // another family — in the same batch as the row itself. It is the child's ONLY way to
    // verify that a family is still deciding — `families/{id}/pending` is member-read-only
    // and a pending child is not a member — so a client that could write it could fake a
    // consent request in progress, and one that could clear it could hide a real one.
    function userDocPreservesServerControlledFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["entitlementTags", "isChildAccount", "childDeclaredAt", "pendingFamilyRequest", "ageOutYearMonth", "pendingDeletionRequestedBy", "pendingDeletionRequestedAtMillis"]);
    }

    // Create-time twin of the diff-guard: a brand-new user doc cannot smuggle any of the
    // keys in (there is no `resource.data` to diff against on create).
    function userDocCreateOmitsServerControlledFields() {
      return !request.resource.data.keys()
        .hasAny(["entitlementTags", "isChildAccount", "childDeclaredAt", "pendingFamilyRequest", "ageOutYearMonth", "pendingDeletionRequestedBy", "pendingDeletionRequestedAtMillis"]);
    }

    // FR-28 (COPPA F-5a): an unconsented child — `isChildAccount == true` with no active
    // family (provisional after declareChildRegistration, or sticky after a consent
    // revocation) — has no gameplay or social cloud collection. One users/{uid} lookup;
    // a missing doc or missing flag means adult. Consented children have activeFamilyId
    // set by the membership-grant batch and cleared by every exit path.
    function callerIsUnconsentedChild() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).data.get('isChildAccount', false) == true
        && !('activeFamilyId' in userDoc(uid()).data);
    }

    // FR-24 (COPPA F-6 rework): a child — consented or not — can never create a family.
    // Guards the direct client `families` create that would otherwise bypass the
    // createFamily callable's child gate. Doc-less callers pass (missing flag ⇒ adult).
    function callerIsNotChildAccount() {
      return !exists(/databases/$(database)/documents/users/$(uid()))
        || userDoc(uid()).data.get('isChildAccount', false) != true;
    }

    // FR-85 (F-42): for a consented child, FAMILY MEMBERSHIP IS THE CREDENTIAL.
    // FR-60 made consented children anonymous Firebase accounts, but `isRegisteredAccount()`
    // is used across this file as the proxy for "legitimate member" — so a consented child
    // silently lost reads they are entitled to (their own roster hydrated to raw uids: the
    // exact degradation the FR-12 carve-out above exists to prevent, in the other direction).
    // This is the replacement proxy, and it is used on READ surfaces ONLY. Registration stays
    // the gate on `families` create, `share_codes` create/update, and every invite surface,
    // where it is a genuine anti-abuse gate (children are separately barred there by
    // `callerIsNotChildAccount()`, FR-24/FR-66(d)). `usernames` reads are no longer
    // registration-gated at all — FR-71 closes them to deny for everyone, so there is no
    // widening question there either.
    //
    // Server-verified end to end. Two of the three facts are server-written only:
    // `isChildAccount` (FR-7 diff-guard) and the member doc (FR-8, client write:false).
    // The third — `activeFamilyId` — IS client-writable on one's own user doc, so it is
    // never trusted alone: the member-doc `exists()` is the authority, and a child that
    // forges `activeFamilyId` gains nothing because no member doc will back it.
    //
    // Ordering discipline, same as FR-12/FR-37 above:
    //   1. every call site puts `isRegisteredAccount()` first, so a registered caller —
    //      the overwhelming majority — short-circuits and pays zero extra document access;
    //   2. the string / non-empty guard comes BEFORE the path is constructed, so an
    //      orphaned or sticky post-revocation child (flag true, family cleared on exit)
    //      denies cleanly instead of erroring on a malformed path;
    //   3. the `exists()` on the caller's own doc precedes every `get()`, because `get()`
    //      on a missing document error-denies.
    function callerIsConsentedChildMemberOf(familyId) {
      return isSignedIn()
        && familyId is string
        && familyId != ''
        && exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).data.get('isChildAccount', false) == true
        && userDoc(uid()).data.get('activeFamilyId', '') == familyId
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(uid()));
    }

    // The caller's own active family, or '' when they have no user doc or no family.
    // Guarded with `exists()` for the same reason as `targetIsNotHiddenChild` below.
    function callerActiveFamilyId() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? userDoc(uid()).data.get('activeFamilyId', '')
        : '';
    }

    // FR-85: the exact read surface a consented child legitimately needs — the roster of
    // their OWN family, scoped by their OWN `activeFamilyId`, never a blanket anonymous read.
    // `userId` must hold a member doc in that family, which is the same invariant the server
    // already enforces over a child's entire peer surface (`evaluateTripChildParticipation`:
    // every other member of a roster containing a child is a member of that child's family).
    // Membership is proved by the member doc rather than by the peer's `activeFamilyId`, so
    // retired-general members — who hold a member doc but carry no `activeFamilyId` of their
    // own — hydrate correctly instead of showing as raw uids.
    function callerIsConsentedChildFamilyPeerOf(userId) {
      return callerIsConsentedChildMemberOf(callerActiveFamilyId())
        && exists(/databases/$(database)/documents/families/$(callerActiveFamilyId())/members/$(userId));
    }

    // FR-37 (COPPA F-5b): the FR-12 carve-out for a document that is NOT the user doc, so
    // the flag has to be fetched. Same ordering discipline as FR-12 (child check first,
    // key-presence guard before path construction), with a leading `exists()` because
    // `get()` on a missing user doc would error-deny — a residual stats row for a deleted
    // account must stay readable exactly as it is today. Callers reading their OWN stats
    // short-circuit at the call site and pay nothing.
    function targetIsNotHiddenChild(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId))
        || userDoc(userId).data.get('isChildAccount', false) != true
        || ( 'activeFamilyId' in userDoc(userId).data
             && exists(/databases/$(database)/documents/families/$(userDoc(userId).data.activeFamilyId)/members/$(uid())) );
    }

    function isFamilyMember(familyId) {
      return exists(/databases/$(database)/documents/families/$(familyId)/members/$(uid()));
    }

    function familyMemberRole(familyId, userId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(userId)).data.role;
    }

    function isCreator(familyId) {
      return isFamilyMember(familyId) && familyMemberRole(familyId, uid()) == "creator";
    }

    function isCaptain(familyId) {
      return isFamilyMember(familyId) && familyMemberRole(familyId, uid()) == "captain";
    }

    // FR-80 (COPPA F-36, fresh-audit finding M-2): usernames cannot silently carry a
    // child's real identity. `UsernameProfanityFilter` / `UsernameValidation`
    // (Core/Utilities/UsernameProfanityFilter.swift) run client-side only, and every
    // userName write reaches this collection via a direct client SDK
    // `setData(merge:true)` (`FirebaseAuthService.saveUserDataToFirestore` — there is no
    // callable in this path), so a modified client can send any string here today. This
    // is the actual enforcement boundary; the Swift filter stays for UX only.
    //
    // Charset is deliberately ASCII-only (no `\p{L}` Unicode class): every allowed
    // character is exactly one code unit, so the `{3,24}` bound here and any future
    // `.size()` check agree with no Unicode-counting ambiguity — in a regex engine this
    // change cannot be executed against outside the coordinator-run emulator (SRS §2).
    // Revisit if the owner wants accented nicknames for es/fr.
    //
    // '@' is not in the allowed charset, so an email shape (`local@domain`) is
    // structurally impossible; '(' ')' '+' are excluded too. The two digit-shape checks
    // below reject a bare run and the common NANP-grouped form. Per FR-80's own framing,
    // this is heuristic hardening, not PII detection — not a guarantee no identity
    // fragment can ever be encoded in 3-24 characters.
    function isValidUserNameFormat(name) {
      return name is string
        && name.matches('^[A-Za-z0-9_.-]{3,24}$')
        && !name.matches('^[0-9]{7,24}$')
        && !name.matches('^[0-9]{3}[.-]?[0-9]{3}[.-]?[0-9]{4}$')
        && !name.lower().matches('.*([a@4][_.-]?[s5$][_.-]?[s5$][_.-]?h[_.-]?[o0][_.-]?l[_.-]?[e3]|b[_.-]?[a@4][_.-]?[s5$][_.-]?[t7][_.-]?[a@4][_.-]?r[_.-]?d|b[_.-]?[i1!][_.-]?[t7][_.-]?c[_.-]?h|b[_.-]?[o0][_.-]?l[_.-]?l[_.-]?[o0][_.-]?c[_.-]?k[_.-]?[s5$]|c[_.-]?[o0][_.-]?c[_.-]?k[_.-]?[s5$][_.-]?u[_.-]?c[_.-]?k[_.-]?[e3][_.-]?r|c[_.-]?u[_.-]?n[_.-]?[t7]|f[_.-]?u[_.-]?c[_.-]?k|m[_.-]?[o0][_.-]?[t7][_.-]?h[_.-]?[e3][_.-]?r[_.-]?f[_.-]?u[_.-]?c[_.-]?k[_.-]?[e3][_.-]?r|p[_.-]?[i1!][_.-]?[s5$][_.-]?[s5$]|p[_.-]?u[_.-]?[s5$][_.-]?[s5$][_.-]?y|[s5$][_.-]?h[_.-]?[i1!][_.-]?[t7]|[s5$][_.-]?l[_.-]?u[_.-]?[t7]|[t7][_.-]?[i1!][_.-]?[t7][_.-]?[s5$]|[t7][_.-]?w[_.-]?[a@4][_.-]?[t7]|w[_.-]?[a@4][_.-]?n[_.-]?k[_.-]?[e3][_.-]?r|w[_.-]?h[_.-]?[o0][_.-]?r[_.-]?[e3]|c[_.-]?[a@4][_.-]?b[_.-]?r[_.-]?[o0][_.-]?n|c[_.-]?[a@4][_.-]?r[_.-]?[a@4][_.-]?j[_.-]?[o0]|c[_.-]?[o0][_.-]?j[_.-]?[o0][_.-]?n[_.-]?[e3][_.-]?[s5$]|c[_.-]?[o0][_.-]?n[_.-]?[o0]|g[_.-]?[i1!][_.-]?l[_.-]?[i1!][_.-]?p[_.-]?[o0][_.-]?l[_.-]?l[_.-]?[a@4][_.-]?[s5$]|j[_.-]?[o0][_.-]?d[_.-]?[e3][_.-]?r|m[_.-]?[a@4][_.-]?r[_.-]?[i1!][_.-]?c[_.-]?[o0][_.-]?n|m[_.-]?[i1!][_.-]?[e3][_.-]?r[_.-]?d[_.-]?[a@4]|p[_.-]?[e3][_.-]?n[_.-]?d[_.-]?[e3][_.-]?j[_.-]?[o0]|p[_.-]?[o0][_.-]?l[_.-]?l[_.-]?[a@4]|p[_.-]?u[_.-]?[t7][_.-]?[a@4]|p[_.-]?u[_.-]?[t7][_.-]?[o0]|v[_.-]?[e3][_.-]?r[_.-]?g[_.-]?[a@4]|z[_.-]?[o0][_.-]?r[_.-]?r[_.-]?[a@4]|b[_.-]?[i1!][_.-]?[t7][_.-]?[e3]|b[_.-]?[o0][_.-]?r[_.-]?d[_.-]?[e3][_.-]?l|c[_.-]?h[_.-]?[i1!][_.-]?[a@4][_.-]?[s5$][_.-]?[s5$][_.-]?[e3]|c[_.-]?[o0][_.-]?n[_.-]?n[_.-]?[a@4][_.-]?r[_.-]?d|c[_.-]?[o0][_.-]?n[_.-]?n[_.-]?[a@4][_.-]?[s5$][_.-]?[s5$][_.-]?[e3]|c[_.-]?[o0][_.-]?u[_.-]?[i1!][_.-]?l[_.-]?l[_.-]?[e3]|[e3][_.-]?n[_.-]?c[_.-]?u[_.-]?l[_.-]?[e3]|f[_.-]?[o0][_.-]?u[_.-]?[t7][_.-]?r[_.-]?[e3]|m[_.-]?[e3][_.-]?r[_.-]?d[_.-]?[e3]|n[_.-]?[i1!][_.-]?q[_.-]?u[_.-]?[e3]|p[_.-]?u[_.-]?[t7][_.-]?[a@4][_.-]?[i1!][_.-]?n|p[_.-]?u[_.-]?[t7][_.-]?[e3]|[s5$][_.-]?[a@4][_.-]?l[_.-]?[o0][_.-]?p[_.-]?[e3]).*');
    }
    // The blocklist above is the SAME English/Spanish/French list as
    // `UsernameProfanityFilter.blockedTerms`, with the SAME single-valued leet
    // substitution (each letter's bracket class also accepts the ONE leet character
    // the Swift filter maps onto it: a/@/4, e/3, i/1/!, o/0, s/5/$, t/7) and the same
    // separator-stripping tolerance (an optional '_' / '.' / '-' between every letter —
    // the only punctuation `isValidUserNameFormat` admits, so nothing else can be used
    // to break a word up). This is a DELIBERATE parity choice, not an oversight: FR-80's
    // no-multi-candidate-expansion decision (owner-reaffirmed 2026-08-26) means a known
    // client-side gap like "f4ck" (the leet map has no substitute for 'u', so it
    // normalizes to "fack", not "fuck") is preserved here on purpose. The server's job
    // is to reject exactly what the client's own filter would already reject — no
    // stronger — so a modified client cannot reach a result a stock client couldn't.
    // Generated from the exact same term list and self-tested against Python's `re`
    // (equivalent semantics for this construct set — character classes, alternation,
    // `?`, `.*`; no lookaround or backreferences anywhere, so RE2 agrees) rather than
    // the Firestore emulator, which this change cannot execute against; unexecuted
    // against RE2 itself pending the coordinator's emulator run (SRS §2).
    match /users/{userId} {
      allow read: if isSignedIn() && isDiscoverableUserProfile(userId);
      allow create: if isSignedIn() && uid() == userId && userDocHasNoPrivateFields()
        && userDocCreateOmitsServerControlledFields()
        && (!('userName' in request.resource.data) || isValidUserNameFormat(request.resource.data.userName));
      // FR-80: only a CHANGING userName is gated on update. Every profile write
      // re-sends the current value (`firestoreDataFromAppUser` always includes it),
      // so validating unconditionally would lock any pre-existing account whose
      // username predates this rule out of every future write — including ones that
      // never touch userName — breaking FR-80's own "existing dev usernames
      // unaffected (pre-release: no migration)" acceptance line.
      allow update: if isSignedIn() && uid() == userId && userDocHasNoPrivateFields()
        && userDocPreservesServerControlledFields()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userName'])
            || isValidUserNameFormat(request.resource.data.get('userName', '')));
      allow delete: if false; // handle via backend flows if needed
    }

    // Owner-only side docs. `fcm` holds the push routing token (read by Cloud Functions
    // via the Admin SDK); `contact` holds email/phone + linked-platform contact.
    // `lastLoginLocationData` is intentionally NOT allowed: the silent login-location
    // flow was removed (F-1). Leftover dev docs are deleted by scripts/deleteLoginLocationData.ts.
    // FR-73 / v2.1 FR-53(a): the server-side backstop on the push token. An FCM token is a
    // persistent identifier, so an UNCONSENTED child (provisional inside the FR-60
    // redemption window, or sticky after a revocation) may not have one — the client
    // eligibility guard is the first line, this is what a tampered or stale client cannot
    // get past.
    //
    // Scoped to CREATE/UPDATE of `fcm` only, and every other operation is left exactly as it
    // was, for three reasons that are each load-bearing:
    //   1. DELETE stays open — `clearFCMToken` (sign-out) and any client-side cleanup must
    //      still be able to REMOVE a token a session is no longer entitled to. Denying
    //      delete would strand the very document this rule exists to keep from existing.
    //   2. READ stays open — a child reading their own routing doc collects nothing new, and
    //      denying it would break the owner-only read `private/` exists to provide.
    //   3. `contact` is untouched — FR-73 is about the push identifier, and re-gating the
    //      contact doc here would silently change an unrelated F-5a surface.
    // Cost: one user-doc get() on token writes only, which happen at most once per session.
    match /users/{userId}/private/{docId} {
      allow read: if isSignedIn() && uid() == userId &&
        (docId == "contact" || docId == "fcm");
      allow delete: if isSignedIn() && uid() == userId &&
        (docId == "contact" || docId == "fcm");
      allow create, update: if isSignedIn() && uid() == userId &&
        (docId == "contact" ||
         (docId == "fcm" && !callerIsUnconsentedChild()));
    }

    // Email/phone lookup indexes — Admin SDK / Cloud Functions only
    match /user_lookup_email/{emailLower} {
      allow read, write: if false;
    }

    match /user_lookup_phone/{phoneId} {
      allow read, write: if false;
    }

    // Public lifetime stats (read-only aggregate mirror; writes via Admin SDK / Cloud Functions only)
    // FR-37: strangers must not be able to confirm a child uid exists, or monitor their
    // play, through the stats mirror. Same child exclusion + family carve-out as FR-12.
    // FR-48 (COPPA F-11): peer reads are further restricted to registered (non-anonymous)
    // accounts, mirroring the isDiscoverableUserProfile clause order — self always reads
    // their own stats regardless of registration status; only the peer branch requires it.
    // FR-85 (F-42): a consented child is an anonymous account, so FR-48's registration test
    // was also denying them their own family's stats. Same caller-side widening as
    // isDiscoverableUserProfile, in the same clause position; FR-37's target-side child
    // exclusion is untouched and still applies to the child caller.
    match /public_lifetime_stats/{userId} {
      allow read: if isSignedIn()
        && (uid() == userId
            || ((isRegisteredAccount() || callerIsConsentedChildFamilyPeerOf(userId))
                && targetIsNotHiddenChild(userId)));
      allow write: if false;
    }

    // User progression (XP / milestones; writes via Cloud Functions only)
    match /user_progression/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;

      match /xp_grants/{grantId} {
        allow read: if isSignedIn() && uid() == userId;
        allow write: if false;
      }
    }

    // User achievements (server-authoritative unlock rows; writes via Cloud Functions only)
    match /user_achievements/{userId}/achievements/{achievementId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;
    }

    // USERNAME INDEX (write via Cloud Function / transaction)
    // FR-71 (F-27, COPPA v3): closed to deny entirely — SUPERSEDES FR-48's "registered
    // (non-anonymous) accounts" read rule below. This doc maps a username straight to a
    // uid; leaving it client-readable at all let any registered caller enumerate arbitrary
    // usernames one `get()` at a time with none of `searchUsers`' protections — no
    // `user_search` rate limit, no audit row, no length floor. Verified zero-regression the
    // same way FR-48 did: the shipped client never reads this collection directly (all
    // lookups go through the `searchUsers` callable via the Admin SDK, which bypasses these
    // rules entirely, so denying client reads here does not touch that path).
    match /usernames/{usernameLower} {
      allow read: if false;
      allow write: if false; // server-only to preserve uniqueness
    }

    // FRIENDSHIPS
    // FR-14 follow-up (COPPA F-5b, owner-approved): friend edges are now server-written
    // only. The F-5a rules allowed client creates/updates with an unconsented-child gate,
    // but a client-side rules check cannot express FR-14 — "neither party is a child" would
    // need a get() on the *other* user's doc on every write, and it still could not enforce
    // the friend caps, the duplicate-invite rules, or the friendCount bookkeeping.
    // Verified zero-regression: the shipped client never writes this collection (no
    // setData/updateData/addDocument against `friends` anywhere in the iOS sources;
    // `FriendshipRepository` reads only, and every mutation goes through
    // respondToFriendInvite / removeFriend / the account-deletion + FR-36 cleanup, all
    // Admin SDK). Reads are unchanged: the two parties still see their own edge.
    match /friends/{friendshipId} {
      allow read: if isSignedIn() &&
        (uid() == resource.data.userA || uid() == resource.data.userB);

      allow create, update, delete: if false;
    }

    function isTripSessionMember(sessionId, userId) {
      return exists(/databases/$(database)/documents/trip_sessions/$(sessionId)/members/$(userId));
    }

    // TRIP INVITES (mutations via Cloud Functions only)
    match /trip_invites/{inviteId} {
      allow read: if isSignedIn() &&
        (uid() == resource.data.fromUserId || uid() == resource.data.toUserId);
      allow create, update, delete: if false;
    }

    // FR-28 enumeration (COPPA F-5a): no rules block permits direct client GAMEPLAY
    // writes — trip_sessions, games, activity_events, participant_prefs,
    // fairness_ack_watermarks, user_progression, user_achievements and
    // public_lifetime_stats are all client write:false, so the unconsented-child gate
    // for gameplay lives entirely in the callables (assertNotUnconsentedChild). Of the
    // social surfaces, F-5b closed `friends` to clients entirely and `invites` to client
    // CREATES (FR-14 follow-up / FR-16a), so the only remaining client-writable path that
    // creates shared social state is `share_codes` — it carries the
    // callerIsUnconsentedChild() check below. (`invites` updates remain party-only and
    // cannot create a new relationship, only respond to one the server already made.)

    // TRIP SESSIONS — minimal metadata + authoritative roster in members (writes server-only)
    match /trip_sessions/{sessionId} {
      // TODO(step-08-rules-hardening): Optionally allow invite-party read access before membership, if product needs pre-accept trip metadata.
      allow read: if isSignedIn() &&
        (resource.data.createdBy == uid() || isTripSessionMember(sessionId, uid()));
      allow create, update, delete: if false;
    }

    match /trip_sessions/{sessionId}/members/{memberId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid());
      allow create, update, delete: if false;
    }

    // Trip canonical games & events (read by members; writes via Cloud Functions only)
    match /trip_sessions/{sessionId}/games/{gameId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid());
      allow create, update, delete: if false;
    }

    match /trip_sessions/{sessionId}/games/{gameId}/private/{docId} {
      allow get: if isSignedIn() &&
        (isAdmin() || resource.data.userId == uid());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /trip_sessions/{sessionId}/activity_events/{eventId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid());
      allow create, update, delete: if false;
    }

    match /trip_sessions/{sessionId}/activity_events/{eventId}/private/{docId} {
      allow get: if isSignedIn() &&
        (isAdmin() || resource.data.userId == uid());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Fairness UI watermark per user per game (writes via updateFairnessAckWatermark only)
    match /trip_sessions/{sessionId}/games/{gameId}/fairness_ack_watermarks/{userId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid()) && userId == uid();
      allow create, update, delete: if false;
    }

    // Per-participant voice/location prefs (writes via upsertTripParticipantPrefs / seed on join)
    match /trip_sessions/{sessionId}/participant_prefs/{userId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid()) && userId == uid();
      allow create, update, delete: if false;
    }

    // INVITES
    match /invites/{inviteId} {
      // Parties can always read; family members can read family invites for their family.
      allow read: if isSignedIn() &&
        (uid() == resource.data.fromUserId
          || uid() == resource.data.toUserId
          || (resource.data.type == "family"
              && resource.data.familyId is string
              && isFamilyMember(resource.data.familyId)));

      // FR-16(a) (COPPA F-5b): invite creation is server-side only. Every live creator is
      // a Cloud Function (sendFriendInvite / sendFamilyInvite / redeemShareCode, all Admin
      // SDK); the iOS client only ever reads `invites` and calls those callables, so this
      // is zero-regression. It closes forged invites for adults too — a client could
      // previously mint an invite naming any fromUserId/toUserId pair.
      allow create: if false;

      // FR-66(c) (COPPA F-22, closes v2.1 §18 residual (a)/G53): a party could previously
      // rewrite ANY field of an invite they were named on — including `familyId`, which
      // retargets the invite at a family the sender never had rights to, and `type`, which
      // converts a friend invite into a family one. Only the response itself is a party's to
      // write. Verified zero-regression: the shipped client never updates `invites` at all
      // (it reads them and calls the callables); every live status change is Admin SDK.
      allow update: if isRegisteredAccount()
        && (uid() == resource.data.fromUserId || uid() == resource.data.toUserId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "updatedAt"]);

      allow delete: if false;
    }

    // SHARE CODES
    // FR-28: share codes admit strangers into families/friendships, so a child may neither
    // mint nor manage them. Redemption is unaffected — redeemShareCode is a Cloud Function
    // and stays a child's path back into consented play.
    //
    // FR-66(d) (F-22, closes v2.1 §18 residual (b)/G39): two holes closed here.
    //   - `!callerIsUnconsentedChild()` let a CONSENTED child mint codes — but minting is
    //     stranger-contact initiation, which sits outside `consentScope` no matter what a
    //     parent agreed to. `callerIsNotChildAccount()` is the axis the callable already
    //     uses (`assertCallerIsNotChild`), so rules and callable now agree.
    //   - nothing checked that the minter belonged to the family the code NAMES. Any adult
    //     could mint a live join code for a family they had merely seen the id of, and
    //     `activeFamilyId` is readable on peer user docs. Applied to update as well, so the
    //     familyId cannot be retargeted after the fact.
    //
    // FR-67 (F-23): the read rule was `isSignedIn()` — every signed-in account could LIST
    // the whole collection and harvest live codes, which made the 6-character code space
    // irrelevant. Scoped to the owner and the named family; a stranger with a code in hand
    // still redeems it through the `redeemShareCode` callable (Admin SDK, rules-exempt),
    // which is now the only resolver and is rate-limited. Verified zero-regression: the
    // client's only live query is by familyId (`FamilyRepository.getActiveShareCode`), and
    // its only write is the owner revoking their own code.
    // Write-path helper only. The absent-familyId default is TRUE because a friend code
    // names no family, so there is nothing to own — correct when authorizing a write the
    // caller is already proving ownership of via `createdBy == uid()`.
    // It MUST NOT be reused on the read path: there the same default makes every friend
    // code world-readable to any signed-in account, which is the exact hole FR-67 closes.
    function shareCodeFamilyIsOwned(codeData) {
      return !('familyId' in codeData) || isFamilyMember(codeData.familyId);
    }

    // Read is deliberately the strict form, not `shareCodeFamilyIsOwned`: a friend code is
    // readable only by its creator; a family code additionally by that family's members.
    function shareCodeIsReadableBySelf(codeData) {
      return codeData.createdBy == uid()
        || ('familyId' in codeData && isFamilyMember(codeData.familyId));
    }

    match /share_codes/{codeId} {
      allow read: if isSignedIn() && shareCodeIsReadableBySelf(resource.data);
      allow create: if isRegisteredAccount() && callerIsNotChildAccount()
        && request.resource.data.createdBy == uid()
        && shareCodeFamilyIsOwned(request.resource.data);
      allow update: if isRegisteredAccount() && callerIsNotChildAccount()
        && resource.data.createdBy == uid()
        && shareCodeFamilyIsOwned(request.resource.data);
      allow delete: if false;
    }

    // FAMILIES
    match /families/{familyId} {
      allow read: if isSignedIn() && isFamilyMember(familyId);

      // create family allowed for registered non-child accounts; membership enforced
      // via backend. Child check closes the callable-bypass hole (FR-24, F-6 rework).
      allow create: if isRegisteredAccount() && callerIsNotChildAccount();
      // Captains/creators may rename only (name + updatedAt). Other fields are server-managed.
      allow update: if isRegisteredAccount()
        && (isCreator(familyId) || isCaptain(familyId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false; // never delete; mark inactive via backend
    }

    match /families/{familyId}/members/{memberId} {
      allow read: if isSignedIn() && isFamilyMember(familyId);

      // FR-8 (COPPA F-5a): member docs are server-written only. They carry the `isChild`
      // projection, so any client write path would be an unaudited flag flip. All live
      // membership mutations already flow through Cloud Functions — zero client regression.
      allow create, update, delete: if false;
    }

    match /families/{familyId}/pending/{requestId} {
      allow read: if isSignedIn() && isFamilyMember(familyId);

      // FR-66(a) (COPPA F-22, supersedes FR-16(b)/G-6): join requests are minted
      // SERVER-SIDE ONLY. Self-naming was never enough, because family membership is this
      // app's parental-consent object: a child could mint a throwaway "adult" account, call
      // createFamily to become their own captain, write a truthfully self-named request
      // from their real flagged account (target familyIds are harvestable — `activeFamilyId`
      // is on the peer-readable user doc), then approve themselves as not-a-child. Closing
      // creation removes the middle step entirely; `respondToFamilyInvite_UserStep` is now
      // the only minter and stamps the invite it came from (see
      // `familyJoinRequestIntegrity.ts`), which the approval callable requires.
      //
      // Verified zero-regression: the shipped client only ever READS this subcollection —
      // a snapshot listener (`FamilyRepository.startListening`) and a status-filtered
      // getDocuments (`FamilyRepository.fetchPendingRequests`). There is no client write.
      allow create: if false;
      // FIELD-GUARDED (2026-08-17). The update rule was unfielded, so a captain could rewrite
      // ANY field of a lineage-stamped row from a modified client — including `userId`. That
      // is a parental-consent bypass, not a display bug: repoint `userId`, approve, and
      // `approveFamilyJoinRequest_CaptainStep` grants family membership — this app's consent
      // object — to an arbitrary uid under a stamp proving an invite was issued to someone
      // else. It also let a captain undo FR-89's expiry by flipping `status` back, or move
      // `createdAt` to extend the window. Resolution is all a captain legitimately does from
      // the client, and the server (Admin SDK) is unaffected by this rule, so every real
      // approve/decline path still works.
      allow update: if isRegisteredAccount()
        && (isCreator(familyId) || isCaptain(familyId))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "resolvedAt"]);
      allow delete: if false;
    }

    // STATS
    match /families/{familyId}/stats/{docId} {
      allow read: if isSignedIn() && isFamilyMember(familyId);
      allow write: if false; // server-only updates
    }

    // APP CONFIG (read-only for clients; writes via Admin SDK / console)
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // FR-59/FR-59.1 email_plus consent requests (server-only, full stop). The document
    // carries the guardian's email and the HASHED confirmation nonce; the emailed link is
    // the only credential, and no client — guardian's included — may read or write here.
    // AGEOUT FR-110's `ageOutYearMonth` joined the user-doc server-controlled key guard
    // above in the same change: it is stamped at declaration and drives age-out detection,
    // so a client that could write it could fake an age, and one that could clear it could
    // make a child undetectable.
    match /consent_requests/{requestId} {
      allow read, write: if false;
    }

    // AUDIT LOGS
    match /audit_logs/{eventId} {
      allow read: if false; // restrict to admins via custom claims in future
      allow create: if false; // server-only
      allow update, delete: if false;
    }

    // Plate-found FCM coalesce buffers (Admin SDK only)
    match /plate_found_notify_buffers/{bufferId} {
      allow read, write: if false;
    }
  }
}

