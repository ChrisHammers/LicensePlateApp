rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRegisteredAccount() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function uid() {
      return request.auth.uid;
    }

    // Own profile always readable. Peers: registered callers only, and target must not be anonymous.
    //
    // FR-12 (COPPA F-5b): a peer may not read a child's user doc unless they are in the
    // child's active family. Clause order is load-bearing:
    //   1. the child check comes FIRST, so an adult target (the overwhelming majority)
    //      short-circuits and pays no extra document access at all;
    //   2. the `'activeFamilyId' in resource.data` key-presence guard comes BEFORE the path
    //      is constructed, so an orphaned child — flag sticky, family cleared on exit —
    //      denies cleanly instead of erroring on a malformed path. An ex-family member is
    //      therefore denied along with every other stranger.
    // The carve-out exists because family screens hydrate rosters by reading each member's
    // user doc directly (`UserProfileListenCoordinator` / `UserRepository.getUser`);
    // without it, flagging a child would silently break their own family's roster.
    function isDiscoverableUserProfile(userId) {
      return uid() == userId
        || (isRegisteredAccount()
            && resource.data.get('isRegistered', true) != false
            && ( resource.data.get('isChildAccount', false) != true
                 || ( 'activeFamilyId' in resource.data
                      && exists(/databases/$(database)/documents/families/$(resource.data.activeFamilyId)/members/$(request.auth.uid)) ) ));
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isRetiredGeneral(userId) {
      return userDoc(userId).data.isRetiredGeneral == true;
    }

    // Rules cannot iterate lists, so bound the array and check every index explicitly.
    // `platform` is a 7-case enum and the client dedupes by platform, so 7 is the true cap.
    function linkedPlatformEntryIsPublicSafe(entries, i) {
      return entries.size() <= i
        || entries[i].keys().hasOnly(["platform", "platformUserId", "linkedAt"]);
    }

    // FR-43: peer-readable linkedPlatforms carry identity only. Provider email / phoneNumber /
    // displayName belong to users/{uid}/private/contact.
    function userDocLinkedPlatformsAreSanitized() {
      return !request.resource.data.keys().hasAny(["linkedPlatforms"])
        || (request.resource.data.linkedPlatforms is list
            && request.resource.data.linkedPlatforms.size() <= 7
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 0)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 1)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 2)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 3)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 4)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 5)
            && linkedPlatformEntryIsPublicSafe(request.resource.data.linkedPlatforms, 6));
    }

    // Reads are document-level, so anything a peer must not see cannot live on users/{uid}:
    // contact goes to private/contact, the push token to private/fcm (FR-43 / audit E1).
    // firstName/lastName: real names are never collected (owner decision, F-6 rework).
    // Deleting a field with FieldValue.delete() keeps it out of request.resource.data, so
    // migration writes that strip these keys still pass.
    // entitlementTags may remain on merge results; clients must not *change* them
    // (see userDocPreservesEntitlementTags). Do not list them here or updates fail for tagged users.
    function userDocHasNoPrivateFields() {
      return !request.resource.data.keys().hasAny([
        "deviceIdentifier",
        "lastLoginLocationData",
        "lastLoginLocations",
        "lastLoginLocation",
        "email",
        "phoneNumber",
        "firstName",
        "lastName",
        "fcmToken",
        "fcmTokenUpdatedAt"
      ]) && userDocLinkedPlatformsAreSanitized();
    }

    // FR-7 (COPPA F-5a): server-controlled user-doc fields. `entitlementTags` are granted
    // by entitlement functions; `isChildAccount` is the authoritative child flag written
    // only by declareChildRegistration / setFamilyMemberChildStatus /
    // approveFamilyJoinRequest_CaptainStep. A client write may carry them through
    // unchanged (merge results) but may never change, add, or remove them.
    function userDocPreservesServerControlledFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["entitlementTags", "isChildAccount"]);
    }

    // Create-time twin of the diff-guard: a brand-new user doc cannot smuggle either key
    // in (there is no `resource.data` to diff against on create).
    function userDocCreateOmitsServerControlledFields() {
      return !request.resource.data.keys().hasAny(["entitlementTags", "isChildAccount"]);
    }

    // FR-28 (COPPA F-5a): an unconsented child — `isChildAccount == true` with no active
    // family (provisional after declareChildRegistration, or sticky after a consent
    // revocation) — has no gameplay or social cloud collection. One users/{uid} lookup;
    // a missing doc or missing flag means adult. Consented children have activeFamilyId
    // set by the membership-grant batch and cleared by every exit path.
    function callerIsUnconsentedChild() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).data.get('isChildAccount', false) == true
        && !('activeFamilyId' in userDoc(uid()).data);
    }

    // FR-24 (COPPA F-6 rework): a child — consented or not — can never create a family.
    // Guards the direct client `families` create that would otherwise bypass the
    // createFamily callable's child gate. Doc-less callers pass (missing flag ⇒ adult).
    function callerIsNotChildAccount() {
      return !exists(/databases/$(database)/documents/users/$(uid()))
        || userDoc(uid()).data.get('isChildAccount', false) != true;
    }

    // FR-37 (COPPA F-5b): the FR-12 carve-out for a document that is NOT the user doc, so
    // the flag has to be fetched. Same ordering discipline as FR-12 (child check first,
    // key-presence guard before path construction), with a leading `exists()` because
    // `get()` on a missing user doc would error-deny — a residual stats row for a deleted
    // account must stay readable exactly as it is today. Callers reading their OWN stats
    // short-circuit at the call site and pay nothing.
    function targetIsNotHiddenChild(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId))
        || userDoc(userId).data.get('isChildAccount', false) != true
        || ( 'activeFamilyId' in userDoc(userId).data
             && exists(/databases/$(database)/documents/families/$(userDoc(userId).data.activeFamilyId)/members/$(uid())) );
    }

    function isFamilyMember(familyId) {
      return exists(/databases/$(database)/documents/families/$(familyId)/members/$(uid()));
    }

    function familyMemberRole(familyId, userId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(userId)).data.role;
    }

    function isCreator(familyId) {
      return isFamilyMember(familyId) && familyMemberRole(familyId, uid()) == "creator";
    }

    function isCaptain(familyId) {
      return isFamilyMember(familyId) && familyMemberRole(familyId, uid()) == "captain";
    }

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn() && isDiscoverableUserProfile(userId);
      allow create: if isSignedIn() && uid() == userId && userDocHasNoPrivateFields()
        && userDocCreateOmitsServerControlledFields();
      allow update: if isSignedIn() && uid() == userId && userDocHasNoPrivateFields()
        && userDocPreservesServerControlledFields();
      allow delete: if false; // handle via backend flows if needed
    }

    // Owner-only side docs. `fcm` holds the push routing token (read by Cloud Functions
    // via the Admin SDK); `contact` holds email/phone + linked-platform contact.
    // `lastLoginLocationData` is intentionally NOT allowed: the silent login-location
    // flow was removed (F-1). Leftover dev docs are deleted by scripts/deleteLoginLocationData.ts.
    match /users/{userId}/private/{docId} {
      allow read, write: if isSignedIn() && uid() == userId &&
        (docId == "contact" || docId == "fcm");
    }

    // Email/phone lookup indexes — Admin SDK / Cloud Functions only
    match /user_lookup_email/{emailLower} {
      allow read, write: if false;
    }

    match /user_lookup_phone/{phoneId} {
      allow read, write: if false;
    }

    // Public lifetime stats (read-only aggregate mirror; writes via Admin SDK / Cloud Functions only)
    // FR-37: strangers must not be able to confirm a child uid exists, or monitor their
    // play, through the stats mirror. Same child exclusion + family carve-out as FR-12.
    // FR-48 (COPPA F-11): peer reads are further restricted to registered (non-anonymous)
    // accounts, mirroring the isDiscoverableUserProfile clause order — self always reads
    // their own stats regardless of registration status; only the peer branch requires it.
    match /public_lifetime_stats/{userId} {
      allow read: if isSignedIn()
        && (uid() == userId || (isRegisteredAccount() && targetIsNotHiddenChild(userId)));
      allow write: if false;
    }

    // User progression (XP / milestones; writes via Cloud Functions only)
    match /user_progression/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;

      match /xp_grants/{grantId} {
        allow read: if isSignedIn() && uid() == userId;
        allow write: if false;
      }
    }

    // User achievements (server-authoritative unlock rows; writes via Cloud Functions only)
    match /user_achievements/{userId}/achievements/{achievementId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;
    }

    // USERNAME INDEX (write via Cloud Function / transaction)
    // FR-48 (COPPA F-11): reads restricted to registered (non-anonymous) accounts — this
    // doc maps a username straight to a uid, so an anonymous caller gets no exact-match
    // lookup path. The shipped client never reads this collection directly (all lookups
    // go through the `searchUsers` callable via the Admin SDK), so there is no regression.
    match /usernames/{usernameLower} {
      allow read: if isRegisteredAccount();
      allow write: if false; // server-only to preserve uniqueness
    }

    // FRIENDSHIPS
    // FR-14 follow-up (COPPA F-5b, owner-approved): friend edges are now server-written
    // only. The F-5a rules allowed client creates/updates with an unconsented-child gate,
    // but a client-side rules check cannot express FR-14 — "neither party is a child" would
    // need a get() on the *other* user's doc on every write, and it still could not enforce
    // the friend caps, the duplicate-invite rules, or the friendCount bookkeeping.
    // Verified zero-regression: the shipped client never writes this collection (no
    // setData/updateData/addDocument against `friends` anywhere in the iOS sources;
    // `FriendshipRepository` reads only, and every mutation goes through
    // respondToFriendInvite / removeFriend / the account-deletion + FR-36 cleanup, all
    // Admin SDK). Reads are unchanged: the two parties still see their own edge.
    match /friends/{friendshipId} {
      allow read: if isSignedIn() &&
        (uid() == resource.data.userA || uid() == resource.data.userB);

      allow create, update, delete: if false;
    }

    function isTripSessionMember(sessionId, userId) {
      return exists(/databases/$(database)/documents/trip_sessions/$(sessionId)/members/$(userId));
    }

    // TRIP INVITES (mutations via Cloud Functions only)
    match /trip_invites/{inviteId} {
      allow read: if isSignedIn() &&
        (uid() == resource.data.fromUserId || uid() == resource.data.toUserId);
      allow create, update, delete: if false;
    }

    // FR-28 enumeration (COPPA F-5a): no rules block permits direct client GAMEPLAY
    // writes — trip_sessions, games, activity_events, participant_prefs,
    // fairness_ack_watermarks, user_progression, user_achievements and
    // public_lifetime_stats are all client write:false, so the unconsented-child gate
    // for gameplay lives entirely in the callables (assertNotUnconsentedChild). Of the
    // social surfaces, F-5b closed `friends` to clients entirely and `invites` to client
    // CREATES (FR-14 follow-up / FR-16a), so the only remaining client-writable path that
    // creates shared social state is `share_codes` — it carries the
    // callerIsUnconsentedChild() check below. (`invites` updates remain party-only and
    // cannot create a new relationship, only respond to one the server already made.)

    // TRIP SESSIONS — minimal metadata + authoritative roster in members (writes server-only)
    match /trip_sessions/{sessionId} {
      // TODO(step-08-rules-hardening): Optionally allow invite-party read access before membership, if product needs pre-accept trip metadata.
      allow read: if isSignedIn() &&
        (resource.data.createdBy == uid() || isTripSessionMember(sessionId, uid()));
      allow create, update, delete: if false;
    }

    match /trip_sessions/{sessionId}/members/{memberId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid());
      allow create, update, delete: if false;
    }

    // Trip canonical games & events (read by members; writes via Cloud Functions only)
    match /trip_sessions/{sessionId}/games/{gameId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid());
      allow create, update, delete: if false;
    }

    match /trip_sessions/{sessionId}/games/{gameId}/private/{docId} {
      allow get: if isSignedIn() &&
        (isAdmin() || resource.data.userId == uid());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /trip_sessions/{sessionId}/activity_events/{eventId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid());
      allow create, update, delete: if false;
    }

    match /trip_sessions/{sessionId}/activity_events/{eventId}/private/{docId} {
      allow get: if isSignedIn() &&
        (isAdmin() || resource.data.userId == uid());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Fairness UI watermark per user per game (writes via updateFairnessAckWatermark only)
    match /trip_sessions/{sessionId}/games/{gameId}/fairness_ack_watermarks/{userId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid()) && userId == uid();
      allow create, update, delete: if false;
    }

    // Per-participant voice/location prefs (writes via upsertTripParticipantPrefs / seed on join)
    match /trip_sessions/{sessionId}/participant_prefs/{userId} {
      allow read: if isSignedIn() && isTripSessionMember(sessionId, uid()) && userId == uid();
      allow create, update, delete: if false;
    }

    // INVITES
    match /invites/{inviteId} {
      // Parties can always read; family members can read family invites for their family.
      allow read: if isSignedIn() &&
        (uid() == resource.data.fromUserId
          || uid() == resource.data.toUserId
          || (resource.data.type == "family"
              && resource.data.familyId is string
              && isFamilyMember(resource.data.familyId)));

      // FR-16(a) (COPPA F-5b): invite creation is server-side only. Every live creator is
      // a Cloud Function (sendFriendInvite / sendFamilyInvite / redeemShareCode, all Admin
      // SDK); the iOS client only ever reads `invites` and calls those callables, so this
      // is zero-regression. It closes forged invites for adults too — a client could
      // previously mint an invite naming any fromUserId/toUserId pair.
      allow create: if false;
      allow update: if isRegisteredAccount() &&
        (uid() == resource.data.fromUserId || uid() == resource.data.toUserId);

      allow delete: if false;
    }

    // SHARE CODES
    // FR-28: share codes admit strangers into families/friendships, so an unconsented
    // child may neither mint nor manage them. Redemption is unaffected — redeemShareCode
    // is a Cloud Function and stays a child's path back into consented play.
    match /share_codes/{codeId} {
      allow read: if isSignedIn();
      allow create: if isRegisteredAccount() && !callerIsUnconsentedChild()
        && request.resource.data.createdBy == uid();
      allow update: if isRegisteredAccount() && !callerIsUnconsentedChild()
        && resource.data.createdBy == uid();
      allow delete: if false;
    }

    // FAMILIES
    match /families/{familyId} {
      allow read: if isSignedIn() && isFamilyMember(familyId);

      // create family allowed for registered non-child accounts; membership enforced
      // via backend. Child check closes the callable-bypass hole (FR-24, F-6 rework).
      allow create: if isRegisteredAccount() && callerIsNotChildAccount();
      // Captains/creators may rename only (name + updatedAt). Other fields are server-managed.
      allow update: if isRegisteredAccount()
        && (isCreator(familyId) || isCaptain(familyId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false; // never delete; mark inactive via backend
    }

    match /families/{familyId}/members/{memberId} {
      allow read: if isSignedIn() && isFamilyMember(familyId);

      // FR-8 (COPPA F-5a): member docs are server-written only. They carry the `isChild`
      // projection, so any client write path would be an unaudited flag flip. All live
      // membership mutations already flow through Cloud Functions — zero client regression.
      allow create, update, delete: if false;
    }

    match /families/{familyId}/pending/{requestId} {
      allow read: if isSignedIn() && isFamilyMember(familyId);
      // FR-16(b)/G-6 (COPPA F-5a): a join request must name its own author. A forged
      // request naming another uid could otherwise let a stranger's approval install
      // them as a child's "consenting manager" with family read access.
      allow create: if isRegisteredAccount()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isRegisteredAccount() && (isCreator(familyId) || isCaptain(familyId));
      allow delete: if false;
    }

    // STATS
    match /families/{familyId}/stats/{docId} {
      allow read: if isSignedIn() && isFamilyMember(familyId);
      allow write: if false; // server-only updates
    }

    // APP CONFIG (read-only for clients; writes via Admin SDK / console)
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // AUDIT LOGS
    match /audit_logs/{eventId} {
      allow read: if false; // restrict to admins via custom claims in future
      allow create: if false; // server-only
      allow update, delete: if false;
    }

    // Plate-found FCM coalesce buffers (Admin SDK only)
    match /plate_found_notify_buffers/{bufferId} {
      allow read, write: if false;
    }
  }
}

